# ==============================================================================
# SHADEN | Root .gitignore
# Full-Stack Streetwear E-Commerce Platform (React + Vite | Express | PostgreSQL)
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/
*.tsbuildinfo

# Package Manager Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Environment Variables & Sensitive Credentials
# Keep all secret credentials, private keys, and environment files untracked.
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.local
*.pem
*.key
*.cert
*.crt

# Safe Example Templates (Allow tracking of example configuration files)
!.env.example
!.env.*.example
!.env.template

# ------------------------------------------------------------------------------
# Production Builds & Caches (React / Vite)
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
.cache/
.vite/
.parcel-cache/
.turbo/

# ------------------------------------------------------------------------------
# Database & ORM (PostgreSQL / Prisma)
# ------------------------------------------------------------------------------
# Local database backups, dumps, and logs
*.sql.dump
*.dump
*.backup
*.bak
*.pgdump
*.sqlite
*.db

# Prisma generated client output (configured in prisma/schema.prisma)
/server/generated/
generated/

# ------------------------------------------------------------------------------
# Application Logs & Temporary Files
# ------------------------------------------------------------------------------
logs/
*.log
temp/
tmp/
.temp/
.tmp/

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------------------------------------------------
# IDE & Code Editors
# ------------------------------------------------------------------------------
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# VS Code workspace settings: ignore local state, keep recommended extensions
.vscode/*
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# AI Agent & Assistant Local Artifacts / Tooling
# Local scratchpads, skills, and memory stores generated by AI developer tools
# ------------------------------------------------------------------------------
.windsurf/
.agents/
skills-lock.json
.cursor/
.claude/

# ------------------------------------------------------------------------------
# Docker & Containers (Local Overrides)
# Note: Dockerfile and docker-compose.yml must be tracked; only ignore local overrides
# ------------------------------------------------------------------------------
docker-compose.override.yml
*.local.dockerfile
