# ==============================================================================
# SHADEN | Server Environment Configuration Template
# Duplicate this file as '.env' in the 'server' directory and update with your local values.
# NEVER commit the actual '.env' file to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shaden_db?schema=public"

# Client Application Origin (for CORS configuration)
CLIENT_URL="http://localhost:5173"

# Authentication & Security Secrets (Planned)
# Generate a cryptographically secure random string for JWT signing
JWT_SECRET="replace_with_a_secure_random_secret_key"
JWT_EXPIRES_IN="7d"
